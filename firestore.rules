rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Production data is normally accessed through server APIs. Direct client
    // access is reserved for the authenticated administrator test console.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
